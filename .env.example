DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# sqlite (local default) or postgres
DB_ENGINE=sqlite
DB_NAME=ir_mqms
DB_USER=ir_mqms
DB_PASSWORD=ir_mqms
DB_HOST=127.0.0.1
DB_PORT=5432

SECURE_SSL=false
TIME_ZONE=Asia/Kolkata

# Media storage. Leave USE_S3=false on your PC. Turn it on for PythonAnywhere.
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# PythonAnywhere example (set these in the WSGI file or .env on the server):
# DEBUG=false
# SECRET_KEY=a-long-random-string
# ALLOWED_HOSTS=yourname.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
# DB_ENGINE=sqlite
# SERVE_MEDIA=true
# SECURE_SSL=false
# USE_S3=true
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=ir-mqms-media
# AWS_S3_REGION_NAME=ap-south-1
